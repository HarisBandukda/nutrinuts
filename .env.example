# ═══════════════════════════════════════════════════════════════════════
# NutriNuts — Configuration Template
# ═══════════════════════════════════════════════════════════════════════
#
# This file documents every configurable value in the NutriNuts website
# and notification system. It is a REFERENCE ONLY — the actual values
# live in the files listed under each section.
#
# ⚠️  SECURITY: Values marked [SECRET] must NEVER be committed to Git.
#              They go in Google Apps Script Script Properties, not here.
#
# INSTRUCTIONS:
#   1. Complete the Firebase Setup Guide (marketing/fcm-setup-guide.md)
#   2. Copy the generated values into the files listed below
#   3. Deploy the updated files to nutrinuts.pk
#   4. Deploy the Google Apps Script (google-apps-script.js)
#   5. Register admin devices via /pages/admin-register.html
#
# ═══════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────
# SECTION 1: Firebase Cloud Messaging (FCM)
# ───────────────────────────────────────────────────────────────────────
# Source: Firebase Console → Project Settings → General → Web App Config
# Files to update:
#   • assets/js/config.js           (FIREBASE_CONFIG + FCM_VAPID_KEY)
#   • assets/js/firebase-messaging.js (FIREBASE_CONFIG + VAPID_KEY)
#   • firebase-messaging-sw.js       (FIREBASE_CONFIG)
#
# These values are PUBLIC — safe in frontend JavaScript.
# ───────────────────────────────────────────────────────────────────────

FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID

# Source: Firebase Console → Project Settings → Cloud Messaging → Web Push Certificates
FCM_VAPID_KEY=YOUR_VAPID_KEY

# ───────────────────────────────────────────────────────────────────────
# SECTION 2: Google Apps Script (Backend)
# ───────────────────────────────────────────────────────────────────────
# File: google-apps-script.js
#
# The GAS Web App URL is embedded in:
#   • assets/js/main.js           (GOOGLE_SHEETS_URL constant)
#   • assets/js/firebase-messaging.js (GAS_REGISTER_URL constant)
#
# Both URLs point to the SAME GAS deployment.
# ───────────────────────────────────────────────────────────────────────

GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzajJGRq456pL82TGsRATSjH8-exOeuBWdqxH7HQeMC6F1zOV_5HuLZiFUSaXHIbotbzA/exec

# ───────────────────────────────────────────────────────────────────────
# SECTION 3: Firebase Service Account [SECRET — NEVER COMMIT]
# ───────────────────────────────────────────────────────────────────────
# Source: Firebase Console → Project Settings → Service Accounts → Generate Key
# Storage: Google Apps Script → Project Settings → Script Properties
# Property Name: FIREBASE_SERVICE_ACCOUNT
# Property Value: The ENTIRE JSON content of the downloaded key file
#
# Example (DO NOT use these values — they are fake placeholders):
#
# {
#   "type": "service_account",
#   "project_id": "nutrinuts",
#   "private_key_id": "abc123def456",
#   "private_key": "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0B...\n-----END PRIVATE KEY-----\n",
#   "client_email": "firebase-adminsdk-xxxxx@nutrinuts.iam.gserviceaccount.com",
#   "client_id": "123456789012345678901",
#   "auth_uri": "https://accounts.google.com/o/oauth2/auth",
#   "token_uri": "https://oauth2.googleapis.com/token",
#   "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
#   "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40nutrinuts.iam.gserviceaccount.com"
# }
#
# ⚠️  WARNING: Never commit the real JSON to source control.
#     The only place it should exist is GAS Script Properties.
# ───────────────────────────────────────────────────────────────────────

FIREBASE_SERVICE_ACCOUNT=[SECRET — stored in GAS Script Properties only]

# ───────────────────────────────────────────────────────────────────────
# SECTION 4: Email Recipients
# ───────────────────────────────────────────────────────────────────────
# File: google-apps-script.js (sendOrderEmail function)
#
# Order notification emails are sent to these addresses.
# ───────────────────────────────────────────────────────────────────────

ADMIN_EMAIL_1=nutrinutspk@gmail.com
ADMIN_EMAIL_2=haris.hanif87@gmail.com

# ───────────────────────────────────────────────────────────────────────
# SECTION 5: Google Sheets
# ───────────────────────────────────────────────────────────────────────
# Spreadsheet ID (embedded in the GAS script — this is the data store)
# ───────────────────────────────────────────────────────────────────────

GOOGLE_SHEETS_ID=1MOY9SUTttdxCA4rGhEhmjbT0ZyYHJO05G1S-50NyHv8

# ───────────────────────────────────────────────────────────────────────
# SECTION 6: Business Configuration (Already set — reference only)
# ───────────────────────────────────────────────────────────────────────
# File: assets/js/config.js
# ───────────────────────────────────────────────────────────────────────

BUSINESS_PHONE=0309-6887474
BUSINESS_WHATSAPP=923096887474
BUSINESS_EMAIL=Coming Soon
BUSINESS_ADDRESS=Pakistan
DOMAIN=nutrinuts.pk
SOCIAL_FACEBOOK=fb.com/Nutrinutspk
SOCIAL_INSTAGRAM=instagram.com/nutrinutspk
SOCIAL_TIKTOK=tiktok.com/@nutrinuts10

# ───────────────────────────────────────────────────────────────────────
# QUICK DEPLOYMENT SUMMARY
# ───────────────────────────────────────────────────────────────────────
#
# Before deploying, every "YOUR_" placeholder in these files
# must be replaced with real values:
#
#   ☐ assets/js/config.js            — 7 placeholders (FIREBASE_CONFIG × 6 + FCM_VAPID_KEY)
#   ☐ assets/js/firebase-messaging.js — 8 placeholders (FIREBASE_CONFIG × 6 + VAPID_KEY + GAS_REGISTER_URL)
#   ☐ firebase-messaging-sw.js        — 6 placeholders (FIREBASE_CONFIG × 6)
#
# Total unique values needed: 8 (from Firebase Console + GAS deployment)
#
# After replacing placeholders, deploy files to nutrinuts.pk and
# update the Google Apps Script deployment.
# ───────────────────────────────────────────────────────────────────────
